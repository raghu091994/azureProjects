{
	"name": "dataflow_employees",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronzeParquetEmployees",
						"type": "DatasetReference"
					},
					"name": "bronzeEmp"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SilverParquetEmployee",
						"type": "DatasetReference"
					},
					"name": "sinkSilverEmp"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmployeeID as integer,",
				"          EmployeeName as string,",
				"          Department as string,",
				"          HireDate as date,",
				"          Salary as decimal(10,2)",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     limit: 10,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> bronzeEmp",
				"bronzeEmp select(mapColumn(",
				"          EmployeeID,",
				"          EmployeeName,",
				"          Department,",
				"          HireDate,",
				"          Salary",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 filter(!isNull(EmployeeID) && EmployeeID != 0) ~> filter1",
				"filter1 window(over(EmployeeID),",
				"     asc(EmployeeID, true),",
				"     row_num = rowNumber()) ~> window1",
				"window1 filter(row_num==1) ~> filter2",
				"filter2 select(mapColumn(",
				"          EmployeeID,",
				"          EmployeeName,",
				"          Department,",
				"          HireDate,",
				"          Salary",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkSilverEmp"
			]
		}
	}
}