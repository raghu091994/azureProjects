{
	"name": "dataflow_sales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronzeParquetSales",
						"type": "DatasetReference"
					},
					"name": "bronzeSales"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SilverParquetSales",
						"type": "DatasetReference"
					},
					"name": "sinkSilverSales"
				}
			],
			"transformations": [
				{
					"name": "filter1",
					"description": "Filtering rows using expressions on columns 'CustomerID'; Removing nulls and  zero value PKs. "
				},
				{
					"name": "window1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          SaleID as integer,",
				"          ProductID as integer,",
				"          Quantity as integer,",
				"          SaleDate as date,",
				"          TotalAmount as decimal(10,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 10,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> bronzeSales",
				"bronzeSales filter(!isNull(SaleID) && SaleID != 0) ~> filter1",
				"filter1 window(over(SaleID),",
				"     asc(SaleID, true),",
				"     row_num = rowNumber()) ~> window1",
				"window1 filter(row_num==1) ~> filter2",
				"filter2 select(mapColumn(",
				"          SaleID,",
				"          ProductID,",
				"          Quantity,",
				"          SaleDate,",
				"          TotalAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkSilverSales"
			]
		}
	}
}