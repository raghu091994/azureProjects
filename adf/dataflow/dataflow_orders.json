{
	"name": "dataflow_orders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronzeParquetOrders",
						"type": "DatasetReference"
					},
					"name": "bronzeOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SilverParquetOrders",
						"type": "DatasetReference"
					},
					"name": "sinkSilverOrders"
				}
			],
			"transformations": [
				{
					"name": "filterPK"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as integer,",
				"          CustomerID as integer,",
				"          OrderDate as date,",
				"          OrderAmount as decimal(10,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> bronzeOrders",
				"bronzeOrders filter(!isNull(OrderID) && OrderID!= 0) ~> filterPK",
				"filterPK window(over(OrderID),",
				"     asc(OrderID, true),",
				"     row_num = rowNumber()) ~> window1",
				"window1 filter(row_num == 1) ~> filter1",
				"filter1 select(mapColumn(",
				"          OrderID,",
				"          CustomerID,",
				"          OrderDate,",
				"          OrderAmount",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkSilverOrders"
			]
		}
	}
}