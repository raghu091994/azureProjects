			"type": "string",
			"defaultValue": "@triggerBody().folderPath"
		},
		"eventTriggerBronze_properties_Bronze_Silver_eventTriggered_P1_parameters_pFileName": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
